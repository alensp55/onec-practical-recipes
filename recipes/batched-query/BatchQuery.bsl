// Делит массив значений на пакеты заданного размера, сохраняя исходный порядок.
Функция РазбитьНаПакеты(Значения, РазмерПакета) Экспорт

    Если РазмерПакета <= 0 Тогда
        ВызватьИсключение "Размер пакета должен быть больше нуля";
    КонецЕсли;

    Результат = Новый Массив;
    ТекущийПакет = Неопределено;

    Для Каждого Значение Из Значения Цикл
        Если ТекущийПакет = Неопределено Тогда
            ТекущийПакет = Новый Массив;
            Результат.Добавить(ТекущийПакет);
        ИначеЕсли ТекущийПакет.Количество() = РазмерПакета Тогда
            ТекущийПакет = Новый Массив;
            Результат.Добавить(ТекущийПакет);
        КонецЕсли;
        ТекущийПакет.Добавить(Значение);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Выполняет один подготовленный запрос для каждого пакета и объединяет таблицы результата.
// Параметр запроса должен использоваться как список в условии В(...).
Функция ВыполнитьЗапросПакетами(Запрос, Значения, РазмерПакета, ИмяПараметра = "Ключи") Экспорт

    Результат = Неопределено;

    Для Каждого Пакет Из РазбитьНаПакеты(Значения, РазмерПакета) Цикл
        Запрос.УстановитьПараметр(ИмяПараметра, Пакет);
        ТаблицаПакета = Запрос.Выполнить().Выгрузить();

        Если Результат = Неопределено Тогда
            Результат = ТаблицаПакета.Скопировать();
            Продолжить;
        КонецЕсли;

        Для Каждого СтрокаПакета Из ТаблицаПакета Цикл
            ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаПакета);
        КонецЦикла;
    КонецЦикла;

    Если Результат = Неопределено Тогда
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;

    Возврат Результат;

КонецФункции
