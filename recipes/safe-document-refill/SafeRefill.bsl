// Возвращает безопасное действие для одной группы загружаемых данных.
//
// Параметры:
//  КоличествоДокументов - Число - количество однозначно подходящих документов.
//  Режим - Строка - Перезаполнить, СоздатьНовый или Пропустить.
//
// Возвращаемое значение:
//  Структура - результат выбора:
//   * Действие - Строка;
//   * Причина - Строка.
Функция ОпределитьДействие(КоличествоДокументов, Режим) Экспорт

    Если КоличествоДокументов > 1 Тогда
        Возврат Новый Структура(
            "Действие,Причина",
            "ПропуститьНеоднозначность",
            "Найдено несколько подходящих документов");
    КонецЕсли;

    Если КоличествоДокументов = 0 Тогда
        Если Режим = "Пропустить" Тогда
            Возврат Новый Структура("Действие,Причина", "Пропустить", "Документ не найден");
        КонецЕсли;
        Возврат Новый Структура("Действие,Причина", "СоздатьНовый", "Документ не найден");
    КонецЕсли;

    Если Режим = "Перезаполнить" Тогда
        Возврат Новый Структура("Действие,Причина", "Перезаполнить", "Найден один документ");
    ИначеЕсли Режим = "СоздатьНовый" Тогда
        Возврат Новый Структура("Действие,Причина", "СоздатьНовый", "Выбран режим создания");
    ИначеЕсли Режим = "Пропустить" Тогда
        Возврат Новый Структура("Действие,Причина", "Пропустить", "Выбран режим пропуска");
    КонецЕсли;

    ВызватьИсключение СтрШаблон("Неизвестный режим обработки: %1", Режим);

КонецФункции

// Возвращает копию строк, в которой заменены только строки с ключами из новых данных.
//
// Параметры:
//  СуществующиеСтроки - ТаблицаЗначений - исходные строки с колонкой КлючСтроки.
//  НовыеСтроки - ТаблицаЗначений - новые строки той же структуры с колонкой КлючСтроки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - объединённые строки без изменения входных таблиц.
Функция ЗаменитьЗатронутыеСтроки(СуществующиеСтроки, НовыеСтроки) Экспорт

    Результат = СуществующиеСтроки.Скопировать();
    КлючиНовыхСтрок = Новый Соответствие;

    Для Каждого НоваяСтрока Из НовыеСтроки Цикл
        Если ПустаяСтрока(НоваяСтрока.КлючСтроки) Тогда
            ВызватьИсключение "У новой строки не заполнен КлючСтроки";
        КонецЕсли;
        Если КлючиНовыхСтрок.Получить(НоваяСтрока.КлючСтроки) <> Неопределено Тогда
            ВызватьИсключение СтрШаблон("Ключ новой строки встречается повторно: %1", НоваяСтрока.КлючСтроки);
        КонецЕсли;
        КлючиНовыхСтрок.Вставить(НоваяСтрока.КлючСтроки, Истина);
    КонецЦикла;

    Индекс = Результат.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Если КлючиНовыхСтрок.Получить(Результат[Индекс].КлючСтроки) <> Неопределено Тогда
            Результат.Удалить(Индекс);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

    Для Каждого НоваяСтрока Из НовыеСтроки Цикл
        СтрокаРезультата = Результат.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаРезультата, НоваяСтрока);
    КонецЦикла;

    Возврат Результат;

КонецФункции
