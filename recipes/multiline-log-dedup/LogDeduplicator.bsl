// Возвращает новые сообщения журнала. При неоднозначных границах используется построчное сравнение.
//
// Параметры:
//  ТекущиеБлоки - Массив из Строка - сообщения текущего запуска.
//  ПредыдущиеБлоки - Массив из Строка - сообщения предыдущего запуска.
//  ГраницыОднозначны - Булево - Истина, если каждый элемент массива содержит одно полное сообщение.
//
// Возвращаемое значение:
//  Массив из Строка - сообщения или строки, которых не было в предыдущем запуске.
Функция ОтобратьНовыеСообщения(ТекущиеБлоки, ПредыдущиеБлоки, ГраницыОднозначны) Экспорт

    Если ГраницыОднозначны Тогда
        Возврат ОтобратьНовыеЗначения(ТекущиеБлоки, ПредыдущиеБлоки);
    КонецЕсли;

    ТекущиеСтроки = РазвернутьБлокиВСтроки(ТекущиеБлоки);
    ПредыдущиеСтроки = РазвернутьБлокиВСтроки(ПредыдущиеБлоки);
    Возврат ОтобратьНовыеЗначения(ТекущиеСтроки, ПредыдущиеСтроки);

КонецФункции

// Возвращает элементы текущего массива, отсутствующие в предыдущем массиве.
// Повтор одного нового сообщения сохраняется один раз.
Функция ОтобратьНовыеЗначения(ТекущиеЗначения, ПредыдущиеЗначения)

    Предыдущие = Новый Соответствие;
    Для Каждого Значение Из ПредыдущиеЗначения Цикл
        Предыдущие.Вставить(НормализоватьТекст(Значение), Истина);
    КонецЦикла;

    Добавленные = Новый Соответствие;
    Результат = Новый Массив;
    Для Каждого Значение Из ТекущиеЗначения Цикл
        НормализованноеЗначение = НормализоватьТекст(Значение);
        Если ПустаяСтрока(НормализованноеЗначение) Тогда
            Продолжить;
        КонецЕсли;
        Если Предыдущие.Получить(НормализованноеЗначение) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Добавленные.Получить(НормализованноеЗначение) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Результат.Добавить(Значение);
        Добавленные.Вставить(НормализованноеЗначение, Истина);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Разворачивает массив блоков текста в массив непустых строк.
Функция РазвернутьБлокиВСтроки(Блоки)

    Результат = Новый Массив;
    Для Каждого Блок Из Блоки Цикл
        Для Каждого СтрокаБлока Из СтрРазделить(Блок, Символы.ПС) Цикл
            Если Не ПустаяСтрока(СокрЛП(СтрокаБлока)) Тогда
                Результат.Добавить(СтрокаБлока);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Нормализует переводы строк и пробелы по краям, сохраняя текст подробностей.
Функция НормализоватьТекст(Текст)

    Результат = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
    Результат = СтрЗаменить(Результат, Символы.ВК, Символы.ПС);
    Возврат СокрЛП(Результат);

КонецФункции
