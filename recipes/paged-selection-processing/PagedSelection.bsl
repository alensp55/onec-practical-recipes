// Последовательно получает и обрабатывает страницы, не накапливая полный набор в памяти.
//
// ПоставщикСтраниц должен реализовать ПолучитьСтраницу(ПослеКлюча, РазмерСтраницы).
// ОбработчикСтраниц должен реализовать Обработать(Страница). Каждая строка содержит уникальное поле Ключ.
Функция ОбработатьПостранично(
    ПоставщикСтраниц,
    ОбработчикСтраниц,
    РазмерСтраницы,
    НачальныйКурсор = Неопределено) Экспорт

    Курсор = НачальныйКурсор;
    Обработано = 0;

    Пока Истина Цикл
        Страница = ПоставщикСтраниц.ПолучитьСтраницу(Курсор, РазмерСтраницы);
        КлючиСтраницы = Новый Массив;
        Для Каждого СтрокаСтраницы Из Страница Цикл
            КлючиСтраницы.Добавить(СтрокаСтраницы.Ключ);
        КонецЦикла;

        План = ПланСледующейСтраницы(КлючиСтраницы, Курсор, РазмерСтраницы);
        Если Страница.Количество() = 0 Тогда
            Прервать;
        КонецЕсли;

        ОбработчикСтраниц.Обработать(Страница);
        Обработано = Обработано + Страница.Количество();

        Если Не План.Продолжать Тогда
            Прервать;
        КонецЕсли;
        Курсор = План.Курсор;
    КонецЦикла;

    Возврат Обработано;

КонецФункции

// Проверяет страницу и возвращает курсор следующего чтения.
//
// Возвращаемое значение:
//  Структура:
//   * Продолжать - Булево;
//   * Курсор - Произвольный - последний ключ страницы или входной курсор для пустой страницы.
Функция ПланСледующейСтраницы(КлючиСтраницы, ТекущийКурсор, РазмерСтраницы) Экспорт

    Если РазмерСтраницы <= 0 Тогда
        ВызватьИсключение "Размер страницы должен быть больше нуля";
    КонецЕсли;
    Если КлючиСтраницы.Количество() > РазмерСтраницы Тогда
        ВызватьИсключение "Поставщик вернул больше строк, чем запрошено";
    КонецЕсли;

    ПредыдущийКлюч = ТекущийКурсор;
    Для Каждого Ключ Из КлючиСтраницы Цикл
        Если Ключ = Неопределено Тогда
            ВызватьИсключение "Ключ страницы не заполнен";
        КонецЕсли;
        Если ПредыдущийКлюч <> Неопределено И Ключ <= ПредыдущийКлюч Тогда
            ВызватьИсключение "Ключи страницы должны строго возрастать";
        КонецЕсли;
        ПредыдущийКлюч = Ключ;
    КонецЦикла;

    Продолжать = КлючиСтраницы.Количество() = РазмерСтраницы;
    Возврат Новый Структура("Продолжать,Курсор", Продолжать, ПредыдущийКлюч);

КонецФункции
