// Атомарно меняет состояние после блокировки записи и повторного чтения внутри транзакции.
//
// Хранилище должно реализовать методы Заблокировать(Ключ), ПолучитьСостояние(Ключ) и
// ЗаписатьСостояние(Ключ, Состояние). Конкретные метаданные остаются в реализации хранилища.
Функция СменитьСостояние(Хранилище, Ключ, ОжидаемоеСостояние, НовоеСостояние) Экспорт

    НачатьТранзакцию();
    Попытка
        Хранилище.Заблокировать(Ключ);
        ТекущееСостояние = Хранилище.ПолучитьСостояние(Ключ);
        Решение = ПроверитьПереход(ТекущееСостояние, ОжидаемоеСостояние, НовоеСостояние);

        Если Решение.Выполнить Тогда
            Хранилище.ЗаписатьСостояние(Ключ, НовоеСостояние);
        КонецЕсли;

        ЗафиксироватьТранзакцию();
        Возврат Решение;
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецФункции

// Определяет результат оптимистичного перехода без чтения или записи данных.
//
// Возвращаемое значение:
//  Структура:
//   * Выполнить - Булево - требуется ли запись;
//   * Код - Строка - Выполнить, УжеВыполнено или Конфликт;
//   * ФактическоеСостояние - Строка.
Функция ПроверитьПереход(ТекущееСостояние, ОжидаемоеСостояние, НовоеСостояние) Экспорт

    Если ТекущееСостояние = НовоеСостояние Тогда
        Возврат Новый Структура(
            "Выполнить,Код,ФактическоеСостояние", Ложь, "УжеВыполнено", ТекущееСостояние);
    КонецЕсли;

    Если ТекущееСостояние <> ОжидаемоеСостояние Тогда
        Возврат Новый Структура(
            "Выполнить,Код,ФактическоеСостояние", Ложь, "Конфликт", ТекущееСостояние);
    КонецЕсли;

    Возврат Новый Структура("Выполнить,Код,ФактическоеСостояние", Истина, "Выполнить", ТекущееСостояние);

КонецФункции
