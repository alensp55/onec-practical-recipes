// Строит относительную иерархию, в которой выбранный узел становится корнем.
//
// Параметры:
//  ИсходнаяИерархия - ТаблицаЗначений - строки дерева:
//   * Ключ - Строка - уникальный ключ узла;
//   * Родитель - Строка - ключ родительского узла или пустая строка.
//  КлючКорня - Строка - узел, который должен стать корнем результата.
//
// Возвращаемое значение:
//  ТаблицаЗначений - выбранный узел и его потомки:
//   * Ключ - Строка;
//   * Родитель - Строка;
//   * Уровень - Число.
Функция ПостроитьОтносительнуюИерархию(ИсходнаяИерархия, КлючКорня) Экспорт

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Ключ");
    Результат.Колонки.Добавить("Родитель");
    Результат.Колонки.Добавить("Уровень");

    Если ПустаяСтрока(КлючКорня) Тогда
        Возврат Результат;
    КонецЕсли;

    УзлыПоКлючу = Новый Соответствие;
    ДетиПоРодителю = Новый Соответствие;

    Для Каждого ИсходнаяСтрока Из ИсходнаяИерархия Цикл
        Если ПустаяСтрока(ИсходнаяСтрока.Ключ) Тогда
            Продолжить;
        КонецЕсли;

        Если УзлыПоКлючу.Получить(ИсходнаяСтрока.Ключ) <> Неопределено Тогда
            ВызватьИсключение СтрШаблон("Ключ узла встречается повторно: %1", ИсходнаяСтрока.Ключ);
        КонецЕсли;

        УзлыПоКлючу.Вставить(ИсходнаяСтрока.Ключ, ИсходнаяСтрока);
        Дети = ДетиПоРодителю.Получить(ИсходнаяСтрока.Родитель);
        Если Дети = Неопределено Тогда
            Дети = Новый Массив;
            ДетиПоРодителю.Вставить(ИсходнаяСтрока.Родитель, Дети);
        КонецЕсли;
        Дети.Добавить(ИсходнаяСтрока.Ключ);
    КонецЦикла;

    Если УзлыПоКлючу.Получить(КлючКорня) = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    Очередь = Новый Массив;
    Очередь.Добавить(Новый Структура("Ключ,Родитель,Уровень", КлючКорня, "", 0));
    Посещенные = Новый Соответствие;

    Пока Очередь.Количество() > 0 Цикл
        ЭлементОчереди = Очередь[0];
        Очередь.Удалить(0);

        Если Посещенные.Получить(ЭлементОчереди.Ключ) <> Неопределено Тогда
            ВызватьИсключение СтрШаблон("В иерархии обнаружен цикл: %1", ЭлементОчереди.Ключ);
        КонецЕсли;
        Посещенные.Вставить(ЭлементОчереди.Ключ, Истина);

        СтрокаРезультата = Результат.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаРезультата, ЭлементОчереди);

        Дети = ДетиПоРодителю.Получить(ЭлементОчереди.Ключ);
        Если Дети = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Для Каждого КлючРебенка Из Дети Цикл
            Очередь.Добавить(Новый Структура(
                "Ключ,Родитель,Уровень",
                КлючРебенка,
                ЭлементОчереди.Ключ,
                ЭлементОчереди.Уровень + 1));
        КонецЦикла;
    КонецЦикла;

    Возврат Результат;

КонецФункции
