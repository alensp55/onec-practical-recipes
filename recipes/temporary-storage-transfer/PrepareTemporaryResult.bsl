// Создаёт независимый пакет результата только из явно разрешённых полей.
// Функция не обращается к временному хранилищу и пригодна для модульного тестирования.
Функция ПодготовитьРезультат(ИсходныеСтроки, ИменаПолей, ВерсияКонтракта = "1") Экспорт

    Если ИменаПолей.Количество() = 0 Тогда
        ВызватьИсключение "Не указаны поля результата";
    КонецЕсли;

    УникальныеПоля = Новый Соответствие;
    Для Каждого ИмяПоля Из ИменаПолей Цикл
        Если ПустаяСтрока(ИмяПоля) Тогда
            ВызватьИсключение "Имя поля результата не заполнено";
        КонецЕсли;
        Если УникальныеПоля.Получить(ИмяПоля) <> Неопределено Тогда
            ВызватьИсключение СтрШаблон("Поле результата встречается повторно: %1", ИмяПоля);
        КонецЕсли;
        УникальныеПоля.Вставить(ИмяПоля, Истина);
    КонецЦикла;

    ПодготовленныеСтроки = Новый Массив;
    Для Каждого ИсходнаяСтрока Из ИсходныеСтроки Цикл
        ПодготовленнаяСтрока = Новый Структура;
        Для Каждого ИмяПоля Из ИменаПолей Цикл
            Если Не ИсходнаяСтрока.Свойство(ИмяПоля) Тогда
                ВызватьИсключение СтрШаблон("В исходной строке отсутствует поле: %1", ИмяПоля);
            КонецЕсли;
            ПодготовленнаяСтрока.Вставить(ИмяПоля, ИсходнаяСтрока[ИмяПоля]);
        КонецЦикла;
        ПодготовленныеСтроки.Добавить(ПодготовленнаяСтрока);
    КонецЦикла;

    Возврат Новый Структура(
        "Версия,Количество,Строки",
        ВерсияКонтракта,
        ПодготовленныеСтроки.Количество(),
        ПодготовленныеСтроки);

КонецФункции
