// Пытается атомарно захватить задание на ограниченное время.
//
// Хранилище должно реализовать Заблокировать(Ключ), Прочитать(Ключ) и Записать(Ключ, Состояние).
Функция ПопытатьсяЗахватить(Хранилище, Ключ, Владелец, ТекущийМомент, ДлительностьСекунд) Экспорт

    НачатьТранзакцию();
    Попытка
        Хранилище.Заблокировать(Ключ);
        Состояние = Хранилище.Прочитать(Ключ);

        Если Не МожноЗахватить(Состояние, Владелец, ТекущийМомент) Тогда
            ЗафиксироватьТранзакцию();
            Возврат Новый Структура("Захвачено,Состояние", Ложь, Состояние);
        КонецЕсли;

        НовоеСостояние = НовоеСостояниеАренды(Состояние, Владелец, ТекущийМомент, ДлительностьСекунд);
        Хранилище.Записать(Ключ, НовоеСостояние);
        ЗафиксироватьТранзакцию();

        Возврат Новый Структура("Захвачено,Состояние", Истина, НовоеСостояние);
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;

КонецФункции

// Проверяет, свободно ли задание, истекла ли аренда или повторно обратился тот же владелец.
Функция МожноЗахватить(Состояние, Владелец, ТекущийМомент) Экспорт

    Если Состояние = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;
    Если Состояние.Статус = "Ожидает" Тогда
        Возврат Истина;
    КонецЕсли;
    Если Состояние.Статус <> "ВРаботе" Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Состояние.Владелец = Владелец Или Состояние.АрендаДо <= ТекущийМомент;

КонецФункции

// Возвращает независимое состояние новой или продлённой аренды.
Функция НовоеСостояниеАренды(Состояние, Владелец, ТекущийМомент, ДлительностьСекунд) Экспорт

    Если ПустаяСтрока(Владелец) Тогда
        ВызватьИсключение "Владелец аренды не заполнен";
    КонецЕсли;
    Если ДлительностьСекунд <= 0 Тогда
        ВызватьИсключение "Длительность аренды должна быть больше нуля";
    КонецЕсли;

    Если Состояние = Неопределено Тогда
        Версия = 0;
    Иначе
        Версия = Состояние.Версия;
    КонецЕсли;

    Возврат Новый Структура(
        "Статус,Владелец,АрендаДо,Версия",
        "ВРаботе",
        Владелец,
        ДобавитьКДате(ТекущийМомент, "Секунда", ДлительностьСекунд),
        Версия + 1);

КонецФункции
